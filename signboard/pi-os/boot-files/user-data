#cloud-config
# SignBoard kiosk: generated by build-image.sh
hostname: signboard
timezone: Asia/Bangkok
locale: en_US.UTF-8
keyboard:
  layout: us

users:
  - name: signage
    gecos: SignBoard Player
    groups: [adm, audio, video, input, render, plugdev, sudo]
    shell: /bin/bash
    lock_passwd: false
    passwd: "$6$0L0LluULYJMafgPE$335zP.ieJENXDqYUTUKJfr99oaa4JmOAgV5e/0Hr6SELynmSXsUfSMfIt1qXx3m9YfRFLxiNiVK3ExcW.jP79."
    sudo: "ALL=(ALL) NOPASSWD:ALL"

ssh_pwauth: true
chpasswd:
  expire: false

package_update: true
package_upgrade: true
packages:
  - xserver-xorg
  - xinit
  - x11-xserver-utils
  - openbox
  - unclutter
  - jq
  - avahi-daemon
  - fonts-noto-core
  - fonts-noto-color-emoji
  - fonts-thai-tlwg

snap:
  commands:
    - snap install chromium

write_files:
  - path: /etc/systemd/system/getty@tty1.service.d/autologin.conf
    content: |
      [Service]
      ExecStart=
      ExecStart=-/sbin/agetty --autologin signage --noclear %I $TERM
  - path: /usr/local/bin/signboard-kiosk
    permissions: "0755"
    content: |
      #!/bin/bash
      # Started by ~/.xinitrc on tty1 autologin. Runs Chromium full screen on the SignBoard player
      # and restarts it if it ever exits.
      
      CONF=/boot/firmware/signboard.conf
      SERVER_URL="http://localhost:3000"
      ROTATE="normal"
      [ -f "$CONF" ] && . <(tr -d '\r' < "$CONF")   # tolerate a conf edited on Windows
      SERVER_URL="${SERVER_URL%/}"
      ORIGIN=$(echo "$SERVER_URL" | grep -oE '^https?://[^/]+')
      
      # Never blank or power-save the display
      xset s off
      xset s noblank
      xset -dpms
      
      # Rotation: normal | left | right | inverted
      OUTPUT=$(xrandr --query | awk '/ connected/ {print $1; exit}')
      [ -n "$OUTPUT" ] && xrandr --output "$OUTPUT" --rotate "$ROTATE"
      
      unclutter -idle 0.5 -root &
      openbox &
      
      PROFILE="$HOME/snap/chromium/common/signboard-profile"
      mkdir -p "$PROFILE/Default"
      
      while true; do
        # Stop Chromium from showing "restore pages?" after a power cut
        PREFS="$PROFILE/Default/Preferences"
        if [ -f "$PREFS" ]; then
          sed -i 's/"exited_cleanly":false/"exited_cleanly":true/; s/"exit_type":"[^"]*"/"exit_type":"Normal"/' "$PREFS"
        fi
      
        # boot.html waits for the server, then opens /player. A plain-http LAN server is
        # treated as secure so the player's offline cache (service worker) can run.
        /snap/bin/chromium \
          --user-data-dir="$PROFILE" \
          --kiosk --start-fullscreen \
          --noerrdialogs --disable-infobars --no-first-run \
          --disable-session-crashed-bubble --disable-features=Translate,TranslateUI \
          --autoplay-policy=no-user-gesture-required \
          --check-for-update-interval=31536000 \
          --password-store=basic \
          --overscroll-history-navigation=0 --disable-pinch \
          --unsafely-treat-insecure-origin-as-secure="$ORIGIN" \
          "file://$HOME/signboard/boot.html?server=$(printf %s "$SERVER_URL" | jq -sRr @uri)"
        sleep 3
      done
  - path: /home/signage/signboard/boot.html
    owner: signage:signage
    defer: true
    content: |
      <!doctype html>
      <html lang="th">
      <head>
      <meta charset="utf-8">
      <title>SignBoard</title>
      <style>
        html, body { margin: 0; height: 100%; background: #05070d; color: #b8c2dc; cursor: none;
          font-family: 'Noto Sans Thai', 'Noto Sans', sans-serif; }
        body { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 3vh; }
        .spin { width: 7vmin; height: 7vmin; border: .8vmin solid #1e2a4a; border-top-color: #3b5bfd; border-radius: 50%;
          animation: r 1s linear infinite; }
        @keyframes r { to { transform: rotate(360deg); } }
        h1 { color: #fff; font-size: 4.5vmin; margin: 0; font-weight: 600; }
        p { font-size: 2.6vmin; margin: 0; }
      </style>
      </head>
      <body>
      <div class="spin"></div>
      <h1>กำลังเชื่อมต่อเซิร์ฟเวอร์</h1>
      <p id="server"></p>
      <p id="hint"></p>
      <script>
        // Waits until the SignBoard server answers, then opens the player.
        // If the server stays unreachable but this device has played before, open the player
        // anyway: its service worker serves the cached page and media so the loop keeps running.
        const server = (new URLSearchParams(location.search).get('server') || '').replace(/\/$/, '');
        const played = (() => { try { return localStorage.getItem('signboard_played') === '1'; } catch { return false; } })();
        const started = Date.now();
        document.getElementById('server').textContent = server || 'ยังไม่ได้ตั้งค่า SERVER_URL ใน signboard.conf';
      
        const go = () => {
          try { localStorage.setItem('signboard_played', '1'); } catch {}
          location.replace(server + '/player');
        };
      
        async function check() {
          if (!server) return;
          try {
            await fetch(server + '/player', { mode: 'no-cors', cache: 'no-store' });
            return go();
          } catch {}
          const waited = (Date.now() - started) / 1000;
          if (played && waited > 45) return go();
          if (waited > 20) document.getElementById('hint').textContent = 'ตรวจสอบสาย LAN / Wi-Fi และที่อยู่เซิร์ฟเวอร์';
          setTimeout(check, 3000);
        }
        check();
      </script>
      </body>
      </html>
  - path: /home/signage/.xinitrc
    owner: signage:signage
    defer: true
    content: |
      exec /usr/local/bin/signboard-kiosk
  - path: /home/signage/.bash_profile
    owner: signage:signage
    defer: true
    content: |
      # Start the kiosk on the physical console only (not over SSH)
      if [ -z "$DISPLAY" ] && [ "$(tty)" = "/dev/tty1" ]; then
        exec startx -- -nocursor >/dev/null 2>&1
      fi
  - path: /etc/cron.d/signboard-reboot
    content: |
      00 04 * * * root /sbin/shutdown -r now
  - path: /etc/apt/apt.conf.d/52signboard-no-reboot
    content: |
      Unattended-Upgrade::Automatic-Reboot "false";

runcmd:
  - chown -R signage:signage /home/signage
  # Hide boot text and the blinking cursor on the TV
  - sed -i 's/$/ quiet loglevel=3 vt.global_cursor_default=0 consoleblank=0/' /boot/firmware/cmdline.txt
  - grep -q '^disable_splash' /boot/firmware/config.txt || echo 'disable_splash=1' >> /boot/firmware/config.txt
  # Don't wait minutes at boot for a network interface that isn't plugged in
  - systemctl mask systemd-networkd-wait-online.service

power_state:
  mode: reboot
  message: SignBoard setup finished, rebooting into the player
  timeout: 30
  condition: true
